{
    "enable_platforms": {
        "description": "启用的平台",
        "hint": "勾选要启用解析的平台。",
        "type": "list",
        "options": [
            "B站",
            "抖音",
            "小红书",
            "微博",
            "X"
        ],
        "default": [
            "B站",
            "抖音",
            "小红书",
            "微博",
            "X"
        ]
    },
    "bili_settings": {
        "description": "B站设置",
        "type": "object",
        "items": {
            "video_quality": {
                "description": "B站视频下载画质",
                "type": "string",
                "hint": "选择下载视频的画质。",
                "default": "1080P高帧率",
                "options": [
                    "原画 (最高画质)",
                    "8K",
                    "4K",
                    "1080P高帧率",
                    "1080P",
                    "720P",
                    "最低"
                ]
            },
            "video_codecs": {
                "description": "B站视频编码格式",
                "type": "string",
                "hint": "优先下载的视频编码格式 (如 AVC / HEVC / AV1)。",
                "default": "AVC",
                "options": [
                    "AVC",
                    "HEVC",
                    "AV1"
                ]
            },
            "allow_quality_fallback": {
                "description": "超限时自动降画质",
                "type": "bool",
                "hint": "当视频大小超过限制时，自动尝试更低画质下载。",
                "default": true
            },
            "merge_send": {
                "description": "B站合并发送",
                "type": "bool",
                "hint": "开启后将 B 站视频信息和视频合并转发发送（多P默认合并）。不开启只发送单独视频; 视频合并转发总是会有点bug, 推荐单独发送",
                "default": false
            },
            "summary_mode": {
                "description": "B站摘要模式",
                "type": "string",
                "hint": "决定合并发送时摘要节点使用纯文字还是渲染卡片。文字摘要只替换卡片节点，不改变媒体发送方式。",
                "default": "文字摘要",
                "options": [
                    "文字摘要",
                    "渲染卡片"
                ]
            },
            "enable_multi_page": {
                "description": "B站多P视频处理",
                "type": "bool",
                "hint": "开启后，遇到多P视频将按配置下载多个分P。",
                "default": true
            },
            "multi_page_max": {
                "description": "B站多P最多下载数量",
                "type": "int",
                "hint": "多P视频最多下载的分P数量。",
                "default": 3,
                "min": 1,
                "max": 20
            },
            "max_duration_seconds": {
                "description": "B站最大视频时长(秒)",
                "type": "int",
                "hint": "视频时长超过该值时直接提示并忽略后续解析。设为 0 表示不限制。",
                "default": 300,
                "min": 0,
                "max": 86400
            },
            "cookies": {
                "description": "B站Cookies",
                "type": "string",
                "hint": "粘贴导出的 Cookie 字符串（可选）。填写后可下载更高画质。留空则使用游客模式。",
                "default": ""
            },
            "enable_auto_download": {
                "description": "B站自动下载视频",
                "default": true,
                "hint": "关闭后 B站 链接将不再自动下载视频（可用于避免与视频总结插件冲突）。关闭后只会显示视频信息卡片。",
                "type": "bool"
            }
        }
    },
    "douyin_settings": {
        "description": "抖音设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "抖音最多发送媒体数",
                "type": "int",
                "hint": "抖音图集/动图最多发送的数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "抖音视频合并发送",
                "type": "bool",
                "hint": "仅对视频生效。开启时发送摘要+视频的合并转发；关闭时只发送单独视频。图文笔记始终使用合并转发。",
                "default": false
            },
            "summary_mode": {
                "description": "抖音摘要模式",
                "type": "string",
                "hint": "决定合并发送时摘要节点使用纯文字还是渲染卡片。文字摘要只替换卡片节点，不改变媒体发送方式。",
                "default": "文字摘要",
                "options": [
                    "文字摘要",
                    "渲染卡片"
                ]
            },
            "upscayl_double_pass": {
                "description": "Upscayl 双重生图",
                "default": true,
                "hint": "开启后执行两次 AI 升图（Pass 1 -> Pass 2）获得最高精度；关闭后只升图一次（耗时直接砍半）。",
                "type": "bool"
            },
            "upscayl_model_name": {
                "description": "Upscayl AI 模型",
                "default": "自动 (CV特征识别)",
                "hint": "选择 AI 生图调用的模型。选择「自动 (CV特征识别)」将由算法自动匹配二次元或照片模型。",
                "type": "string",
                "options": [
                    "自动 (CV特征识别)",
                    "数字艺术 (digital-art-4x)",
                    "高保真 (high-fidelity-4x)",
                    "Remacri (remacri-4x)",
                    "超混合平衡 (ultramix-balanced-4x)",
                    "超锐化 (ultrasharp-4x)",
                    "轻量 (upscayl-lite-4x)",
                    "标准 (upscayl-standard-4x)"
                ]
            },
            "upscayl_scale": {
                "default": 2,
                "description": "Upscayl 生图倍数",
                "hint": "设置单次生图的放大倍数（支持 1-4 倍，默认 2 倍）。",
                "min": 1,
                "type": "int",
                "max": 4
            },
            "enable_ai_upscale": {
                "description": "AI 升图",
                "default": true,
                "hint": "开启后，对尺寸小于设定阈值的低质量图片自动调用 Upscayl AI 模型进行双重生图与 TAA 增强。",
                "type": "bool"
            },
            "low_quality_threshold": {
                "default": 1080,
                "description": "低质量图片像素阈值(px)",
                "hint": "图片宽度或高度小于该像素值时判定为低质图，自动触发 AI 升图（默认 1080px）。",
                "min": 100,
                "type": "int",
                "max": 4096
            },
            "upscayl_enable_taa": {
                "description": "Upscayl TAA 模式",
                "default": true,
                "hint": "开启后传入 -x 参数，开启 TAA 抗锯齿模式以减少图像伪影。",
                "type": "bool"
            }
        }
    },
