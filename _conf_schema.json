                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "小红书视频合并发送",
                "type": "bool",
                "hint": "仅对视频笔记生效。开启时发送摘要+视频的合并转发；关闭时只发送单独视频。图文笔记始终使用合并转发。",
