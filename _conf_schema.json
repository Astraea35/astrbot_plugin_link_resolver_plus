                "description": "QQ图片转文件阈值(MB)",
                "type": "int",
                "hint": "当单张图片超过此大小时，改为文件组件发送以绕过 QQ 图片体积限制。设为0禁用转换。",
                "default": 30,
                "min": 0,
                "max": 200
            },
            "concurrent_download": {
                "description": "小红书图片并发下载",
                "type": "bool",
                "hint": "开启后同时下载多张图片，大幅提升图集解析速度；关闭则逐张串行下载。如遇下载异常可尝试关闭。",
                "default": true
            },
            "image_merge_send": {
                "description": "小红书图文合并发送",
                "type": "bool",
                "hint": "仅对图文笔记生效。开启时发送卡片+图片的合并转发；关闭时逐张单独发送图片。",
                "default": false
            },
            "upscayl_model_name": {
                "description": "Upscayl AI 模型",
                "type": "string",
                "hint": "选择 AI 生图调用的模型。选择「自动 (CV特征识别)」将由算法自动匹配二次元或照片模型。",
                "default": "自动 (CV特征识别)",
                "options": [
                    "自动 (CV特征识别)",
                    "数字艺术 (digital-art-4x)",
                    "高保真 (high-fidelity-4x)",
                    "Remacri (remacri-4x)",
                    "超混合平衡 (ultramix-balanced-4x)",
                    "超锐化 (ultrasharp-4x)",
                    "轻量 (upscayl-lite-4x)",
                    "标准 (upscayl-standard-4x)"
                ]
            },
            "enable_ai_upscale": {
                "description": "小红书 AI 升图",
                "default": true,
                "hint": "开启后，小红书图片会按通用的低质量图片阈值自动调用 Upscayl AI 升图。",
                "type": "bool"
            }
        }
    },
    "general_settings": {
        "description": "通用设置",
        "type": "object",
        "items": {
            "ai_upscale": {
                "description": "AI 升图设置",
                "type": "object",
                "items": {
                    "upscayl_bin_path": {
                        "description": "Upscayl 可执行文件路径",
                        "type": "string",
                        "hint": "默认使用 Upscayl 标准安装路径。留空或路径不可用时，自动检测插件 resources/bin/upscayl-bin.exe。",
                        "default": "C:/Program Files/Upscayl/resources/bin/upscayl-bin.exe"
                    },
                    "upscayl_models_path": {
                        "description": "Upscayl 模型文件夹路径",
                        "type": "string",
                        "hint": "默认使用 Upscayl 标准安装路径。留空或路径不可用时，自动检测插件 resources/models。",
                        "default": "C:/Program Files/Upscayl/resources/models"
                    },
                    "upscayl_double_pass": {
                        "description": "Upscayl 双重生图",
                        "default": true,
                        "hint": "开启后执行两次 AI 升图（Pass 1 -> Pass 2）获得最高精度；关闭后只升图一次（耗时直接砍半）。",
                        "type": "bool"
                    },
                    "upscayl_scale": {
                        "description": "Upscayl 生图倍数",
                        "default": 2,
                        "hint": "设置单次生图的放大倍数（支持 1-4 倍，默认 2 倍）。",
                        "min": 1,
                        "type": "int",
                        "max": 4
                    },
                    "low_quality_threshold": {
                        "default": 2160,
                        "description": "低质量图片像素阈值(px)",
                        "hint": "图片宽度或高度小于该像素值时判定为低质图，自动触发 AI 升图（默认 2160px）。",
                        "min": 100,
                        "type": "int",
                        "max": 4096
                    },
                    "upscayl_enable_taa": {
                        "description": "Upscayl TAA 模式",
                        "default": true,
                        "hint": "开启后传入 -x 参数，开启 TAA 抗锯齿模式以减少图像伪影。",
                        "type": "bool"
                    }
                }
            },
            "concurrency": {
                "description": "并发任务设置",
                "type": "object",
                "items": {
                    "allow_ai_upscale_ffmpeg_concurrent": {
                        "description": "AI 升图与 FFmpeg 同时工作",
                        "type": "bool",
                        "hint": "关闭后，AI 升图与 FFmpeg 转码任务不会同时执行；开启后两者可并行运行。",
                        "default": false
                    },
                    "ai_upscale_max_concurrent": {
                        "description": "AI 升图并行任务数",
                        "type": "int",
                        "hint": "允许同时运行的 Upscayl AI 升图任务数，默认 1。",
                        "default": 1,
                        "min": 1,
                        "max": 8
                    },
                    "ffmpeg_max_concurrent": {
                        "description": "FFmpeg 并行任务数",
                        "type": "int",
                        "hint": "允许同时运行的 FFmpeg 转码任务数，默认 1。",
                        "default": 1,
                        "min": 1,
                        "max": 8
                    }
                }
            },
            "message_behavior": {
                "description": "解析与交互",
                "type": "object",
                "items": {
                    "retry_count": {
                        "description": "解析失败重试次数",
                        "type": "int",
                        "hint": "各平台解析失败时的重试次数，设为0禁用重试",
                        "default": 3,
                        "min": 0,
                        "max": 10
                    },
                    "reaction_emoji_enabled": {
                        "description": "识别后表情回应",
                        "type": "bool",
                        "hint": "识别到链接/卡片后点一个表情，提示开始处理。",
                        "default": true
                    },
                    "reaction_emoji_list": {
                        "description": "回应表情ID列表(0~5个)",
                        "type": "list",
                        "hint": "QQ emoji_id,空列表=不回应,最多5个。常用:棒棒糖=147 OK=124 赞=76 爱心=66。完整列表: https://bot.q.qq.com/wiki/develop/api-v2/openapi/emoji/model.html",
                        "default": [
                            127827
                        ]
                    },
                    "reaction_emoji_strategy": {
                        "description": "回应策略",
                        "type": "string",
                        "hint": "随机:每次从列表抽1个。顺序循环:按列表依次全部回应,每个间隔0.5s(同一消息多表情)。",
                        "default": "随机",
                        "options": [
                            "随机",
                            "顺序循环"
                        ]
                    }
                }
            },
            "font_rendering": {
                "description": "字体与卡片渲染",
                "type": "object",
                "items": {
                    "auto_install_fonts": {
                        "description": "自动安装插件字体",
                        "type": "bool",
                        "hint": "默认关闭。开启后在插件重载/加载时自动下载中文主字体和 Emoji 字体到插件 data/fonts 目录，并优先用于卡片渲染。会依次尝试多个下载源；若全部失败，可手动将字体文件放到 data/fonts。",
                        "default": false
                    },
                    "custom_font_path": {
                        "description": "自定义主字体路径",
                        "type": "string",
                        "hint": "可选。填写本机或容器内可访问的字体文件绝对路径；配置后优先级高于插件自动安装字体和系统字体。",
                        "default": ""
                    },
                    "custom_emoji_font_path": {
                        "description": "自定义 Emoji 字体路径",
                        "type": "string",
                        "hint": "可选。填写本机或容器内可访问的 Emoji 字体文件绝对路径；配置后优先级高于插件自动安装字体和系统 Emoji 字体。",
                        "default": ""
                    }
                }
            },
            "media_delivery": {
                "description": "媒体发送",
                "type": "object",
                "items": {
                    "max_video_size_mb": {
                        "description": "最大视频大小 (MB)",
                        "type": "int",
                        "hint": "超过此大小的视频将不会下载。设置为 0 表示无限制。",
                        "default": 200,
                        "min": 0,
                        "max": 2048
                    },
                    "napcat_media_share_path": {
                        "description": "NapCat 媒体 SMB 路径",
                        "type": "string",
                        "hint": "仅异机 NapCat 使用。AstrBot 写入的 Windows 共享路径，例如 \\\\192.168.1.34\\Docker\\NapCat\\config\\astrbot-media；同机部署请留空。",
                        "default": ""
                    },
                    "napcat_media_container_path": {
                        "description": "NapCat 容器媒体路径",
                        "type": "string",
                        "hint": "仅异机 NapCat 使用。上述同一目录在 NapCat 容器内的路径，例如 /app/napcat/config/astrbot-media。",
                        "default": ""
                    },
                    "merge_send_as_sender": {
                        "description": "合并转发显示为发送者",
                        "type": "bool",
                        "hint": "开启后合并转发的发送人显示为发送链接的用户；关闭则显示为 Bot。",
                        "default": false
                    }
                }
            },
            "runtime_behavior": {
                "description": "媒体处理与运行",
                "type": "object",
                "items": {
                    "error_notify_mode": {
                        "description": "错误通知模式",
                        "type": "string",
                        "hint": "控制解析/下载失败时 Bot 是否在群内发送错误消息。静默：仅记录日志；脱敏：发送通用错误提示（不含异常详情）；报错：发送完整错误信息。",
                        "default": "静默",
                        "options": [
                            "静默",
                            "脱敏",
                            "报错"
                        ]
                    },
                    "progress_report_interval": {
                        "description": "生图/转码进度日志间隔(%)",
                        "type": "int",
                        "hint": "后台日志中每完成多少百分比输出一次进度。设为1时每1%输出一次，设为10时每10%输出一次。GPU较弱建议设为10以减少日志量。",
                        "default": 1,
                        "min": 1,
                        "max": 100
                    },
                    "enable_ffmpeg_compress": {
                        "description": "全局图片压缩",
                        "type": "bool",
                        "hint": "小红书/抖音/微博/X 平台的图片是否自动转码为所选图片格式。关闭后图片保持原格式。",
                        "default": true
                    },
                    "image_compress_format": {
                        "description": "图片压缩格式",
                        "type": "string",
                        "hint": "AVIF 为高压缩度；JXL 为高质量。",
                        "default": "AVIF（高压缩度）",
                        "options": [
                            "AVIF（高压缩度）",
                            "JXL（高质量）"
                        ]
                    },
                    "jxl_distance": {
                        "description": "自定义 JXL distance 值",
                        "type": "string",
                        "hint": "仅 JXL 生效，默认 1.0（视觉无损）。0：完全无损（自动切换为 Modular 编码模式）。0.5 ~ 0.8：极高保真（专业摄影、微小纹理/噪点极致保留）。1.0：视觉无损（JXL 官方推荐的通用高质量黄金分割点，体积与画质平衡极佳）。1.5 ~ 2.0：Web 高画质分发。PNG 图片固定采用 distance=0 无损压缩。",
                        "default": "1.0"
                    },
                    "preserve_image_metadata": {
                        "description": "保留图片元数据",
                        "type": "bool",
                        "hint": "开启后保留原图的拍摄时间、地点、相机参数、来源、处理记录等元数据；同时适用于平台图片和 /升图、/avif 命令。",
                        "default": true
                    },
                    "ffmpeg_bin_path": {
                        "description": "FFmpeg 可执行文件路径",
                        "type": "string",
                        "hint": "用于全平台图片转码与预览生成；填写 ffmpeg 命令名或绝对路径。",
                        "default": "ffmpeg"
                    },
                    "debounce_seconds": {
                        "description": "重复链接防抖秒数",
                        "type": "int",
                        "hint": "同一会话内重复发送完全相同的链接消息时，在此时间内只解析一次。设为 0 关闭防抖。",
                        "default": 30,
                        "min": 0,
                        "max": 3600
                    }
                }
            }
        }
    },
    "group_filter": {
        "description": "群过滤(黑/白名单)",
        "hint": "默认黑名单模式且列表为空=所有群都放行。私聊不受过滤影响。",
        "type": "object",
        "items": {
            "mode": {
                "description": "过滤模式",
                "type": "string",
                "hint": "黑名单:列表内的群禁用解析;白名单:仅列表内的群启用解析。",
                "default": "黑名单",
                "options": [
                    "黑名单",
                    "白名单"
                ]
            },
            "group_list": {
                "description": "群号列表",
                "type": "list",
                "hint": "QQ 群号(纯数字字符串)。例如 123456789。",
                "default": []
            }
        }
    },
    "private_filter": {
        "description": "私聊过滤(黑/白名单)",
        "hint": "默认黑名单模式且列表为空=所有私聊都放行。",
        "type": "object",
        "items": {
            "mode": {
                "description": "过滤模式",
                "type": "string",
                "hint": "黑名单:列表内的用户禁用解析;白名单:仅列表内的用户启用解析。",
                "default": "黑名单",
                "options": [
                    "黑名单",
                    "白名单"
                ]
            },
            "user_list": {
                "description": "用户 QQ 号列表",
                "type": "list",
                "hint": "私聊用户的 QQ 号(纯数字字符串)。例如: 123456789。",
                "default": []
            }
        }
    },
    "extended_platforms_settings": {
        "description": "扩展平台下载设置",
        "type": "object",
        "items": {
            "proxy_url": {
                "description": "扩展平台代理地址",
                "type": "string",
                "hint": "可选。填写 http://127.0.0.1:7890 或 socks5://127.0.0.1:7890；仅用于快手、YouTube、TikTok、Pixiv 等新增平台。",
                "default": ""
            },
            "cookies_file": {
                "description": "Netscape Cookie 文件路径",
                "type": "string",
                "hint": "可选。填写浏览器导出的 Netscape 格式 Cookie 文件路径，用于需要登录的平台。",
                "default": ""
            },
            "download_timeout": {
                "description": "下载超时(秒)",
                "type": "int",
                "hint": "yt-dlp 或 gallery-dl 单次下载的最大等待时间。",
                "default": 120,
                "min": 30,
                "max": 900
            },
            "max_media": {
                "description": "单链接最多发送媒体数",
                "type": "int",
                "hint": "图集或播放列表只发送前 N 个媒体，避免刷屏。",
                "default": 10,
                "min": 1,
                "max": 99
            },
            "gallery_dl_fallback": {
                "description": "启用 gallery-dl 兜底",
                "type": "bool",
                "hint": "yt-dlp 下载失败或不支持图集时，尝试调用 gallery-dl。Pixiv、Instagram 默认优先使用该工具。",
                "default": true
            },
            "send_summary": {
                "description": "发送解析摘要",
                "type": "bool",
                "hint": "发送媒体前先发送平台、标题、作者和媒体数量。关闭后只发送媒体文件。",
                "default": true
            }
        }
    },
    "session_control": {
        "description": "会话级解析开关",
        "type": "object",
        "items": {
            "enabled": {
                "description": "允许会话单独开关",
                "type": "bool",
                "hint": "开启后可在单个群或私聊中使用“开启解析”“关闭解析”“解析状态”。开关在插件重启后恢复默认开启。",
                "default": true
            }
        }
    },
    "image_tool_settings": {
        "description": "独立图片工具设置",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用 /升图 和 /avif 命令",
                "type": "bool",
                "default": true
            },
            "model_name": {
                "description": "Upscayl AI 模型",
                "type": "string",
                "default": "自动 (CV特征识别)",
                "hint": "选择 AI 升图调用的模型。选择「自动 (CV特征识别)」将由算法自动匹配二次元或照片模型。",
                "options": [
                    "自动 (CV特征识别)",
                    "二次元 (digital-art-4x)",
                    "高保真 (high-fidelity-4x)",
                    "Remacri (remacri-4x)",
                    "超混合平衡 (ultramix-balanced-4x)",
                    "超锐化 (ultrasharp-4x)",
                    "轻量 (upscayl-lite-4x)",
                    "标准 (upscayl-standard-4x)"
                ]
            },
            "upscayl_double_pass": {
                "description": "Upscayl 双重生图",
                "type": "bool",
                "default": true,
                "hint": "开启后执行两次 AI 升图（Pass 1 -> Pass 2）获得最高精度；关闭后只升图一次（耗时直接砍半）。"
            },
            "upscayl_enable_taa": {
                "description": "Upscayl TAA 模式",
                "type": "bool",
                "default": true,
                "hint": "开启后传入 -x 参数，开启 TAA 抗锯齿模式以减少图像伪影。"
            },
            "upscayl_scale": {
                "description": "Upscayl 生图倍数",
                "type": "int",
                "default": 2,
                "min": 1,
                "max": 4,
                "hint": "设置单次生图的放大倍数（支持 1-4 倍，默认 2 倍）。"
            },
            "upscayl_max_resolution": {
                "description": "AI 升图分辨率上限（px）",
                "type": "int",
                "default": 3840,
                "min": 0,
                "max": 16384,
                "hint": "图片任一边超过此像素值时跳过 AI 升图，直接转码为 AVIF。填写 0 表示不设上限。默认 3840px（4K）。"
            },
            "max_image_mb": {
                "description": "下载图片大小上限（MB），填写 0 表示不设上限",
                "type": "int",
                "default": 50,
                "min": 0,
                "max": 500
            }
        }
    }
}
